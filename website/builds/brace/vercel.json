{
  "framework": null,
  "rewrites": [
    {"source": "/", "destination": "/index.html"},
    {"source": "/guide", "destination": "/guide/index.html"},
    {"source": "/guide/", "destination": "/guide/index.html"},
    {"source": "/how-to", "destination": "/how-to/index.html"},
    {"source": "/how-to/", "destination": "/how-to/index.html"}
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; media-src 'self'; font-src 'self' data:; connect-src 'self'; object-src 'none'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
        },
        {"key": "X-Content-Type-Options", "value": "nosniff"},
        {"key": "Referrer-Policy", "value": "strict-origin-when-cross-origin"},
        {"key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=()"},
        {"key": "X-Frame-Options", "value": "DENY"}
      ]
    },
    {
      "source": "/assets/brace-opening.mp4",
      "headers": [
        {"key": "Cache-Control", "value": "public, max-age=31536000, immutable"}
      ]
    }
  ]
}
