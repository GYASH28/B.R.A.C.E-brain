# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/.next-stale-*/
/out/

# production
/build/
/dist/

# website verification output
/website/builds/*/node_modules/
/website/builds/*/lab/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# secrets and local configuration
.env
.env.*
!.env.example
*.key
*.p12
*.pfx
*.keystore

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
local-*
.claude/
.z-ai-config/
*.log
dev.log
dev.out.log
test
prompt
server.log
vault_test*.json

# local databases, exports, backups, and imported memory data
*.sqlite
*.sqlite3
*.sqlite3-*
*.db
*.db-*
*.backup
*.bak
*.export.json
brace-data/
_BRACE_DATA/

# Python and editor caches
.venv/
__pycache__/
*.pyc
.idea/
.vscode/
